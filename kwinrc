[Compositing]
Backend=OpenGL
GLCore=true

[Plugins]
kwin4_effect_shapecornersEnabled=true
blurEnabled=false
glassEnabled=true
glass_x11Enabled=true
slideEnabled=false
slidingpopupsEnabled=true

[Effect-blurplus]
EdgeLighting=false
GlowColor=#20FFFFFF
FakeBlur=false
WindowClasses=
BlurMatching=true
BlurNonMatching=false
BlurDocks=true
BlurMenus=false
TransparentBlur=true
BlurStrength=12
NoiseStrength=0
TopCornerRadius=16
BottomCornerRadius=16
DockCornerRadius=20
MenuCornerRadius=12
Brightness=0.98
Saturation=1.0
Contrast=1.0
RefractionStrength=0.20
RefractionEdgeSize=8
RefractionRGBFringing=0.0

[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__MacTahoe-Dark
ButtonsOnLeft=XIA
ButtonsOnRight=


[Round-Corners]
Exclusions=shell.py
Size=16
InactiveCornerRadius=16
UseSquircleShape=true
Squircleness=0.55
UseNativeDecorationShadows=true
OutlineThickness=0
InactiveOutlineThickness=0
SecondOutlineThickness=0
InactiveSecondOutlineThickness=0
OuterOutlineThickness=0
InactiveOuterOutlineThickness=0
IncludeNormalWindows=true
IncludeDialogs=true
DisableRoundMaximize=true
DisableRoundTile=true
DisableRoundFullScreen=true
